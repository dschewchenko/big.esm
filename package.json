{
  "name": "big.esm",
  "version": "3.1.1",
  "description": "A small, fast JavaScript library for arbitrary-precision decimal arithmetic.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bunx --bun vitest",
    "test:ui": "bunx --bun vitest --ui",
    "test:run": "bunx --bun vitest run",
    "test:package": "bun run build && bun scripts/check-package.mjs",
    "coverage": "bunx --bun vitest run --coverage",
    "docs": "bun run --cwd tools/typedoc generate",
    "lint": "bunx --bun biome check",
    "lint:fix": "bun run lint -- --write",
    "benchmark": "bun benchmarks/benchmark.js",
    "benchmark:compare": "bun benchmarks/benchmark.js",
    "benchmark:weight": "bun benchmarks/size-compare.js",
    "semantic-release": "bunx --bun semantic-release",
    "prepare": "bunx --bun is-ci || bunx --bun husky"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./package": "./package.json",
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./LICENSE": "./LICENSE",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./dist/big.esm": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./dist/big.esm.js": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./dist/core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.js"
    },
    "./dist/core.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.js"
    },
    "./dist/index": {
      "import": "./dist/index.js"
    },
    "./dist/index.js": {
      "import": "./dist/index.js"
    },
    "./dist/package-entry": {
      "import": "./dist/package-entry.js"
    },
    "./dist/package-entry.js": {
      "import": "./dist/package-entry.js"
    },
    "./dist/big": {
      "import": "./dist/big.js"
    },
    "./dist/big.js": {
      "import": "./dist/big.js"
    },
    "./dist/pipeline": {
      "import": "./dist/pipeline.js"
    },
    "./dist/pipeline.js": {
      "import": "./dist/pipeline.js"
    },
    "./dist/operations/*.js": {
      "import": "./dist/operations/*.js"
    },
    "./dist/operations/*": {
      "import": "./dist/operations/*.js"
    },
    "./dist/utils/align-scale": {
      "import": "./dist/utils/align-scale.js"
    },
    "./dist/utils/align-scale.js": {
      "import": "./dist/utils/align-scale.js"
    },
    "./dist/utils/clone": {
      "import": "./dist/utils/clone.js"
    },
    "./dist/utils/clone.js": {
      "import": "./dist/utils/clone.js"
    },
    "./dist/utils/create": {
      "import": "./dist/utils/create.js"
    },
    "./dist/utils/create.js": {
      "import": "./dist/utils/create.js"
    },
    "./dist/utils/from-string": {
      "import": "./dist/utils/from-string.js"
    },
    "./dist/utils/from-string.js": {
      "import": "./dist/utils/from-string.js"
    },
    "./dist/utils/is-big-object": {
      "import": "./dist/utils/is-big-object.js"
    },
    "./dist/utils/is-big-object.js": {
      "import": "./dist/utils/is-big-object.js"
    },
    "./dist/utils/numeric": {
      "import": "./dist/utils/numeric.js"
    },
    "./dist/utils/numeric.js": {
      "import": "./dist/utils/numeric.js"
    },
    "./dist/utils/pow10": {
      "import": "./dist/utils/pow10.js"
    },
    "./dist/utils/pow10.js": {
      "import": "./dist/utils/pow10.js"
    },
    "./dist/utils/to-exponential": {
      "import": "./dist/utils/to-exponential.js"
    },
    "./dist/utils/to-exponential.js": {
      "import": "./dist/utils/to-exponential.js"
    },
    "./dist/utils/to-fixed": {
      "import": "./dist/utils/to-fixed.js"
    },
    "./dist/utils/to-fixed.js": {
      "import": "./dist/utils/to-fixed.js"
    },
    "./dist/types": {
      "types": "./dist/types.d.ts"
    },
    "./dist/types.js": {
      "types": "./dist/types.d.ts"
    },
    "./dist/*.d.ts": {
      "types": "./dist/*.d.ts"
    },
    "./dist/operations/*.d.ts": {
      "types": "./dist/operations/*.d.ts"
    }
  },
  "module": "dist/big.esm.js",
  "types": "dist/package-entry.d.ts",
  "files": [
    "dist/*",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dschewchenko/big.esm.git"
  },
  "keywords": [
    "big",
    "number",
    "bigint",
    "decimal",
    "math",
    "operations"
  ],
  "author": "dschewchenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dschewchenko/big.esm/issues"
  },
  "homepage": "https://github.com/dschewchenko/big.esm#readme",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=16"
  },
  "workspaces": {
    "packages": [
      "tools/typedoc"
    ],
    "selfContained": [
      "tools/typedoc"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "big.js": "^7.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
