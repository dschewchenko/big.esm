{
  "name": "big.esm",
  "version": "3.0.0",
  "description": "A small, fast JavaScript library for arbitrary-precision decimal arithmetic.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bunx --bun vitest",
    "test:ui": "bunx --bun vitest --ui",
    "test:run": "bunx --bun vitest run",
    "test:package": "bun run build && bun scripts/check-package.mjs",
    "coverage": "bunx --bun vitest run --coverage",
    "docs": "bun run --cwd tools/typedoc generate",
    "lint": "bunx --bun biome check",
    "lint:fix": "bun run lint -- --write",
    "benchmark": "bun benchmarks/benchmark.js",
    "benchmark:compare": "bun benchmarks/benchmark.js",
    "benchmark:weight": "bun benchmarks/size-compare.js",
    "semantic-release": "bunx --bun semantic-release",
    "prepare": "bunx --bun is-ci || bunx --bun husky"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./package": "./package.json",
    "./dist/big.esm": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./dist/big.esm.js": {
      "import": {
        "types": "./dist/package-entry.d.ts",
        "default": "./dist/big.esm.js"
      }
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*"
    },
    "./*": "./*"
  },
  "module": "dist/big.esm.js",
  "types": "dist/package-entry.d.ts",
  "files": [
    "dist/*",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dschewchenko/big.esm.git"
  },
  "keywords": [
    "big",
    "number",
    "bigint",
    "decimal",
    "math",
    "operations"
  ],
  "author": "dschewchenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dschewchenko/big.esm/issues"
  },
  "homepage": "https://github.com/dschewchenko/big.esm#readme",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=16"
  },
  "workspaces": {
    "packages": [
      "tools/typedoc"
    ],
    "selfContained": [
      "tools/typedoc"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "big.js": "^7.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
