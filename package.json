{
  "name": "big.esm",
  "version": "1.3.2",
  "description": "A small, fast JavaScript library for arbitrary-precision decimal arithmetic.",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun run typecheck && bunx --bun vite build",
    "typecheck": "bun --bun tsrs --checkers 2 --noEmit",
    "preview": "bunx --bun vite preview",
    "test": "bunx --bun vitest",
    "test:ui": "bunx --bun vitest --ui",
    "test:run": "bunx --bun vitest run",
    "coverage": "bunx --bun vitest run --coverage",
    "docs": "bunx --bun typedoc --out docs",
    "lint": "bunx --bun biome check",
    "lint:fix": "bun run lint -- --write",
    "benchmark": "bun benchmarks/benchmark.js",
    "benchmark:weight": "bun benchmarks/size-compare.js",
    "semantic-release": "bunx --bun semantic-release",
    "prepare": "bunx --bun is-ci || bunx --bun husky"
  },
  "main": "dist/big.esm.umd.cjs",
  "module": "dist/big.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dschewchenko/big.esm.git"
  },
  "keywords": [
    "big",
    "number",
    "bigint",
    "decimal",
    "math",
    "operations"
  ],
  "author": "dschewchenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dschewchenko/big.esm/issues"
  },
  "homepage": "https://github.com/dschewchenko/big.esm#readme",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@typescript/typescript6": "6.0.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/ui": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "big.js": "^7.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typedoc-plugin-pages": "^1.1.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  }
}
